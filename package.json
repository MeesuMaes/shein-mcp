{
  "name": "shein-mcp",
  "version": "0.1.0",
  "description": "SHEIN seller platform MCP server — manage products, prices, stock, orders, shipping and returns via the SHEIN Open Platform API",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "shein-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "contracts"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js serve",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-contracts.mjs",
    "test": "node --test dist-test/test/*.test.js",
    "pretest": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
